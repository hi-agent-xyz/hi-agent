<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows shell. A standalone .NET/WinUI 3 build that speaks the core's
    documented HTTP API and links no Rust — the same independence
    `app/android` and `app/apple/ios` have from each other.

    Unpackaged (`WindowsPackageType=None`) on purpose: the app is delivered by
    the per-user NSIS installer `scripts/make-installer.sh` already builds, not
    by MSIX from the Store. Self-contained twice over — the .NET runtime
    (`SelfContained`) and the Windows App SDK (`WindowsAppSDKSelfContained`) —
    so the installer stays a single download with no prerequisite chain. The
    one runtime dependency left is the WebView2 Evergreen runtime, which ships
    with Windows 11 and arrived on Windows 10 with Edge; `CoreWebView` says what
    happens when it is missing.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HiAgent.Windows</RootNamespace>
    <!-- Stamped by `make bump-version`; VERSION is the source of truth. -->
    <Version>0.2.0</Version>
    <!-- The shell, beside the engine's `hi-agent.exe` in the same directory. -->
    <AssemblyName>HiAgent</AssemblyName>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      Unpackaged, and this still has to be on. `EnableMsixTooling` reads like it
      asks for MSIX, which this app does not want — but without it MrtCore's
      PriGen target resolves its own task assembly to
      `<dotnet-sdk>/Microsoft/VisualStudio/v17.0/AppxPackage/Microsoft.Build.Packaging.Pri.Tasks.dll`,
      a path that exists under a Visual Studio install and never under the .NET
      SDK. So every `dotnet build`/`dotnet publish` of this project dies at
      MSB4062 while the same project builds fine in VS — which is exactly the
      shape release runs 3 and 4 took, and why run 4 failed identically after
      run 3's SDK-version theory was pinned down and turned out to be wrong.
      It is a Windows App SDK bug, known since 1.2, fixed in 1.8-preview1; this
      property is the documented workaround for the 1.6 we pin, and it does not
      disable PRI generation, so `ms-appx:///Assets/…` still resolves.
      https://github.com/microsoft/WindowsAppSDK/issues/4889
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\HiAgent.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The face is the UI. A console window behind it would be a second one. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned, on the terms the wildcards set for themselves: they said to pin
      all three the first time a Windows box restored them, and the v0.1.0
      release run was that first restore. These are the versions it resolved.

      It also showed what the wildcard costs on a project nobody compiles.
      `H.NotifyIcon.WinUI 2.*` had floated to 2.4.1, which ships only
      net10.0-windows10.0.17763, so restore failed NU1202 against this
      project's net8.0-windows10.0.19041.0 — a dependency retargeting the app
      out from under it, discovered at the release, not at a build. 2.3.2 is
      the newest release still carrying a net8.0 lib.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!--
      The tray. Hand-rolling `Shell_NotifyIcon` means a message-only window, a
      subclassed WndProc and icon lifetime across explorer restarts — all of it
      the kind of code that looks right and is not, which is the wrong thing to
      write with no way to run it.
    -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The mark and its two derived states: the tray shows the first while the
      agent answers, the second while it does not, and the third while it has
      its ear open. `scripts/make-tray-icos.py` derives both from the first
      rather than drawing the mark three times.
    -->
    <Content Include="Assets\HiAgent.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\HiAgentGrey.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\HiAgentListening.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
