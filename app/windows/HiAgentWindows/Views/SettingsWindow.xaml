<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HiAgent.Windows.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- Nothing is drawn from a guess: the window shows a spinner until the
             engine has said what every control's value is. -->
        <ProgressRing x:Name="Loading" IsActive="True" Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock x:Name="LoadError"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                   Padding="24" />

        <!-- Four panes, the same four macOS has and in the same order. The
             sidebar is a NavigationView because that is what a Windows settings
             window is; what sits in each pane is `HiSettings.swift`. -->
        <controls:NavigationView x:Name="Nav"
                                 Visibility="Collapsed"
                                 PaneDisplayMode="Left"
                                 OpenPaneLength="188"
                                 IsSettingsVisible="False"
                                 IsBackButtonVisible="Collapsed"
                                 IsPaneToggleButtonVisible="False"
                                 SelectionChanged="OnPaneChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="General" Tag="general" Icon="Setting" IsSelected="True" />
                <controls:NavigationViewItem Content="Account" Tag="account" Icon="Contact" />
                <controls:NavigationViewItem Content="Reach" Tag="reach" Icon="World" />
                <controls:NavigationViewItem Content="About" Tag="about" Icon="Help" />
            </controls:NavigationView.MenuItems>

            <ScrollViewer>
                <StackPanel Padding="28,20,28,28" Spacing="18" MaxWidth="560" HorizontalAlignment="Left">

                    <StackPanel Spacing="2">
                        <!-- Text matches the pane the sidebar starts on, so the
                             heading is right before the first selection lands. -->
                        <TextBlock x:Name="PaneTitle" Text="General"
                                   Style="{ThemeResource TitleTextBlockStyle}" />
                        <!-- Which agent this configures. The window only ever reaches
                             the core on this machine — a remote agent's credentials
                             and reachability belong to the machine hosting it. -->
                        <TextBlock Text="The agent on this computer" Opacity="0.6" />
                    </StackPanel>

                    <!-- General -->
                    <StackPanel x:Name="GeneralPane" Spacing="16">
                        <ComboBox x:Name="ThemeBox" Header="Theme" MinWidth="220"
                                  SelectionChanged="OnThemeChanged" />
                        <ComboBox x:Name="LanguageBox" Header="Language" MinWidth="220"
                                  SelectionChanged="OnLanguageChanged" />
                        <ToggleSwitch x:Name="GesturesSwitch" Header="Attention gestures"
                                      Toggled="OnGesturesToggled" />
                        <TextBlock x:Name="RestartHint" Visibility="Collapsed" Opacity="0.6"
                                   TextWrapping="Wrap"
                                   Text="Some changes take effect the next time Hi Agent starts." />
                    </StackPanel>

                    <!-- Account -->
                    <StackPanel x:Name="AccountPane" Spacing="16" Visibility="Collapsed">
                        <controls:RadioButtons x:Name="ModeChoice" Header="Credentials"
                                               SelectionChanged="OnModeChanged">
                            <RadioButton Content="小圆猪 (managed)" Tag="xiaoyuanzhu" />
                            <RadioButton Content="Your own keys" Tag="byok" />
                        </controls:RadioButtons>

                        <!-- Managed: what the account is and what is left of it. -->
                        <StackPanel x:Name="ManagedPane" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Signed in" Width="110" Opacity="0.7" />
                                <TextBlock x:Name="SignedInText" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Plan" Width="110" Opacity="0.7" />
                                <TextBlock x:Name="PlanText" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="Energy" Width="110" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock x:Name="EnergyText" VerticalAlignment="Center" />
                                <HyperlinkButton x:Name="RefreshEnergyButton" Content="Refresh"
                                                 Click="OnRefreshEnergy" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SignInButton" Content="Sign in" Click="OnSignIn" />
                                <Button x:Name="ManageAccountButton" Content="Manage account"
                                        Click="OnManageAccount" />
                            </StackPanel>
                        </StackPanel>

                        <!-- BYOK: one row per capability, and never a key on screen. -->
                        <StackPanel x:Name="ByokPane" Spacing="4" Visibility="Collapsed">
                            <StackPanel x:Name="FeatureList" Spacing="4" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Reach -->
                    <StackPanel x:Name="ReachPane" Spacing="16" Visibility="Collapsed">
                        <ToggleSwitch x:Name="RelaySwitch" Header="Reachable by name"
                                      Toggled="OnRelayToggled" />
                        <TextBlock x:Name="RelayNote" Opacity="0.6" TextWrapping="Wrap" />

                        <StackPanel x:Name="NamedPane" Spacing="10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Name" Width="80" Opacity="0.7" />
                                <TextBlock x:Name="HandleText" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel x:Name="AddressRow" Orientation="Horizontal" Spacing="12"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Address" Width="80" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock x:Name="AddressText" IsTextSelectionEnabled="True"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <HyperlinkButton x:Name="CopyAddressButton" Content="Copy"
                                                 Click="OnCopyAddress" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="UnnamedPane" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Name" Width="80" Opacity="0.7" />
                                <TextBlock Text="none yet" />
                            </StackPanel>
                            <TextBlock x:Name="ReachWhy" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="AboutPane" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="Hi Agent" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Opacity="0.7" />
                        <HyperlinkButton x:Name="WebsiteLink" Padding="0,4,0,0" />
                    </StackPanel>

                    <!-- A write that did not land. Shown under whichever pane caused
                         it, because that is where the control that failed is. -->
                    <TextBlock x:Name="ErrorText"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </ScrollViewer>
        </controls:NavigationView>
    </Grid>
</Window>
