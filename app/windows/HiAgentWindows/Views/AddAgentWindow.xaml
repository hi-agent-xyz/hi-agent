<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HiAgent.Windows.Views.AddAgentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel Spacing="14">
            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Add a remote hi-agent" />

            <!-- The ordinary path: a name, and somebody to approve it there. -->
            <StackPanel x:Name="NamingPanel" Spacing="14">
                <TextBlock TextWrapping="Wrap" Opacity="0.7"
                           Text="Say which agent this is. It will ask to be let in, and you approve it there — nothing long to type here." />

                <!-- The zone sits beside the box rather than inside it, so typing
                     `iloahz` reads as `iloahz.hi-agent.xyz` and no sentence has to
                     be spent explaining what a name is. -->
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom">
                    <TextBox x:Name="NameBox" Header="Your agent's name"
                             PlaceholderText="your agent" MinWidth="200"
                             TextChanged="OnNameChanged" />
                    <TextBlock x:Name="ZoneText" Opacity="0.6" Margin="4,0,0,8"
                               VerticalAlignment="Bottom" FontFamily="Consolas" />
                </StackPanel>

                <Expander x:Name="AddressExpander" Header="Use a full address"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="For an agent with no name in the zone: its address — http://localhost:12358 for one on this machine — and a one-time code it is showing." />
                        <TextBox x:Name="AddressBox" Header="Address"
                                 PlaceholderText="https://name.hi-agent.xyz" />
                        <TextBox x:Name="CodeBox" Header="One-time code" />
                        <TextBox x:Name="LabelBox" Header="Call it" PlaceholderText="Home" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- The wait: one number, and who has to act on it. -->
            <StackPanel x:Name="WaitingPanel" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="ShownCode" Style="{ThemeResource TitleLargeTextBlockStyle}"
                           FontFamily="Consolas" HorizontalAlignment="Center" />
                <TextBlock x:Name="WaitingFor" TextWrapping="Wrap" Opacity="0.7"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
                <Button Content="Cancel" Click="OnCancel" />
                <Button x:Name="AddButton" Content="Ask to be let in"
                        Style="{ThemeResource AccentButtonStyle}" Click="OnAdd" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
