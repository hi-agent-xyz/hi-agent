<?xml version="1.0" encoding="utf-8"?>
<!--
    The handset and tablet flavor: a touchscreen, a camera to scan a pairing QR
    with, and the home-screen launcher.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The camera is scanning and the face's video channel, and neither is a
         reason to refuse to install on a handset that has no camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HiAgent">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The same `hiagent://pair?url=…&code=…` the core already emits from
                 `pairing_app_url()`. Nothing about the link is Apple-specific, so
                 a QR drawn for an iPhone scans here unchanged. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hiagent" android:host="pair" />
            </intent-filter>

            <!-- Hi Agent in the system share sheet, for anything: a photo, a
                 download, a link from the browser, a selection of text.
                 `mimeType="*/*"` rather than a list, because the file channel's
                 premise is that a person may hand their agent whatever they like.

                 **Sharing lands on the activity itself, not on a separate
                 component** — `singleTask` above means it arrives in the running
                 app — and that is the whole difference from iOS, where a share
                 extension is another process that cannot open its host. Here the
                 conversation is simply on screen a moment later, which is where
                 the person says what they wanted to say about the thing they
                 shared. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
