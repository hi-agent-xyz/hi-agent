<?xml version="1.0" encoding="utf-8"?>
<!--
    What every device this app runs on has in common. The launcher activity, the
    hardware a particular device shape actually has, and the categories it is
    launched from all live in the flavor manifests beside it, because those are
    the things a television and a handset disagree about.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The microphone is the one capture device both shapes may have: a handset
         always, a television only when something is plugged into it or its remote
         exposes one. Declared here and requested at the moment the face asks for
         it (`CoreWebView`), never at launch. The camera is the handset's alone
         and is declared in its flavor. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".HiAgentApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HiAgent" />

    <!-- Off-origin links leave for the browser rather than opening inside the
         app's own chrome; this is the visibility that lets us find one. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>
