<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The only entitlement either target gains. There is deliberately no shared
	     keychain group: the extension never holds a credential, because it never
	     sends anything — see HandedDrop. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.xiaoyuanzhu.hiagent</string>
	</array>
</dict>
</plist>
